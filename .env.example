# Copy to .env and source it in each terminal with:
# set -a; . ./.env; set +a
PORT=5173
BASE_PATH=/

# Optional browser WebSocket bridge URL. Leave empty to use local demo telemetry.
# This must be a browser-compatible WebSocket bridge; MQTT TCP is not a WebSocket.
VITE_NODE_RED_WS_URL=

# Only needed for Drizzle schema push or code that actually connects to PostgreSQL.
# Replace with credentials for a database you control; this is a local example only.
DATABASE_URL=postgresql://localhost:5432/ecosphere
